<Project>
  <PropertyGroup>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <!-- Muss zur Version des Jellyfin-Servers passen. Überschreibbar: dotnet build -p:JellyfinVersion=12.2.0 -->
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.2.0</JellyfinVersion>
  </PropertyGroup>
</Project>
